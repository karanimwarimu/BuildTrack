# BuildTrack configuration. ./start.sh copies this to .env on first run.
# Real environment variables override values in this file.

# --- Application -------------------------------------------------------------
# local = developer conveniences (on-screen reset links, detailed errors, dev elevation allowed)
# production = safe defaults for a shared server
APP_ENV=local
# 127.0.0.1 = only this computer. Use 0.0.0.0 to allow other devices on your network.
APP_HOST=127.0.0.1
APP_PORT=8080
# Public base URL used in password-reset emails. REQUIRED in production, e.g. https://buildtrack.example.com
APP_URL=
APP_TIMEZONE=Africa/Nairobi
CURRENCY=KSh

# --- Database ----------------------------------------------------------------
# SQLite file, relative to the project folder (or an absolute path). Created automatically.
DB_PATH=data/buildtrack.sqlite

# --- Accounts & admin access -------------------------------------------------
# Allow visitors to create their own (worker) accounts. The first account can always be created.
ALLOW_REGISTRATION=true
# The first account registered on an empty database becomes the administrator.
FIRST_USER_IS_ADMIN=true
# Optional: create/promote this administrator at startup (./start.sh or php bin/console migrate).
# ADMIN_PASSWORD is only used to CREATE the account; remove it afterwards. A password change is forced at first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# DEV ONLY: shows a "Make me an administrator" button on My account when APP_ENV=local AND
# you browse from this machine (127.0.0.1). Ignored in production. Every use is audited.
ALLOW_DEV_ADMIN_ELEVATION=false

# --- Security ----------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_TTL_MINUTES=60
UPLOAD_MAX_MB=10

# --- Email (optional) ---------------------------------------------------------
# Leave SMTP_HOST empty to write emails (password-reset links) to data/logs/mail.log instead.
SMTP_HOST=
SMTP_PORT=587
# tls = STARTTLS (port 587), ssl = implicit TLS (port 465), none = plain (local relays only)
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@buildtrack.local
MAIL_FROM_NAME=BuildTrack
